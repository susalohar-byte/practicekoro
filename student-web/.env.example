# PracticeKoro Student Web Panel — public (browser) configuration only.
# These values are baked into the bundle at build time. Never put a service-role key,
# Razorpay key secret or webhook secret here.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Optional: sub-folder the panel is served from (default "/"). Must end with "/".
# VITE_BASE_PATH="/dashboard/"
