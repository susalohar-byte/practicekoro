# PracticeKoro Student Web Panel — public (browser) configuration only.
# These values are baked into the bundle at build time. Never put a service-role key,
# Razorpay key secret or webhook secret here.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Optional: sub-folder the panel is served from (default "/"). Must end with "/".
# VITE_BASE_PATH="/dashboard/"

# Optional: where admin accounts are sent after signing in here (default "/admin";
# in local development "http://localhost:5174/admin").
# VITE_ADMIN_URL="/admin"

# Optional: the site-wide login page the panel's own login sends visitors to (default "/login"
# in builds; local development keeps the panel's own page). Empty = always use the panel's page.
# VITE_SHARED_LOGIN_URL="/login"

# Optional: error monitoring (Sentry). Off when empty.
# VITE_SENTRY_DSN="https://<key>@<org>.ingest.us.sentry.io/<project>"
