# PracticeKoro Environment Variables
# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Razorpay Client Configuration (Key ID only - Key Secret must never be in frontend)
VITE_RAZORPAY_KEY="rzp_test_your_key_id"

# Student Web Panel address used by the landing page's Student Login (default "/dashboard/").
# VITE_STUDENT_PANEL_URL="/dashboard/"

# Demo Mode (Explicitly false by default; enable only for local mock testing)
VITE_ENABLE_DEMO_MODE=false

# Error monitoring (Sentry). Off when empty. The DSN is public by design; it only lets
# the app send error reports. The Student Web Panel reads its own student-web/.env.
# VITE_SENTRY_DSN="https://<key>@<org>.ingest.us.sentry.io/<project>"
